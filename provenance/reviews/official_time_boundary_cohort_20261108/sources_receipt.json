    {
      "id": "used-pair-boundaries",
      "title": "实际研究配对是否越界",
      "queries": [
        {
          "id": "pair-ledger",
          "source": {
            "label": "冻结配对与官方时刻",
            "files": [
              {
                "label": "final_summary.json"
              },
              {
                "label": "historical_boundary_pairs.csv"
              }
            ],
            "filters": [
              "当前七天配对：299364 条",
              "同组 ID 历史合格七天及三十天配对：571823 条"
            ],
            "caveats": [
              "一分钟差异是小时产品起点与目录时刻的差异，不等同于已证明的无效观测。"
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "独立时间计算",
                "detail": "以 nominal target 减预测时长重新计算起点，与 UTC 时间解析结果一致；历史配对的所需区间未超出官方结束时刻。"
              }
            ]
          },
          "columns": [
            "check",
            "pairs"
          ],
          "rows": [
            {
              "check": "当前七天终点超过官方结束时刻",
              "pairs": 0
            },
            {
              "check": "当前七天起点早一分钟",
              "pairs": 1
            },
            {
              "check": "历史所需观测区间超过官方结束时刻",
              "pairs": 0
            },
            {
              "check": "历史起点早一分钟：七天与三十天各一条",
              "pairs": 2
            }
          ],
          "methods": [
            {
              "language": "python",
              "code": "origins = active.target_epoch.to_numpy() - active.horizon_days.to_numpy() * 86400\nassert (origins < active.official_start_epoch).sum() == 1\nassert (active.matched_endpoint_epoch > active.official_end_epoch).sum() == 0"
            }
          ]
        }
      ]
    },
